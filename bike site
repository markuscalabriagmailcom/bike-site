// Create part card with carousel
function createPartCard(part) {
  const container = document.querySelector("#parts-container");
  const card = document.createElement("div");
  card.className = "part-card";

  const carouselId = "carousel-" + Math.random().toString(36).substr(2, 9);
  const imgHtml = part.img.map(src => `
    <div class="carousel-slide">
      <img src="${src}" alt="${part.name}" style="width:100%; max-height:200px; object-fit:cover; border-radius:5px;">
    </div>
  `).join("");

  card.innerHTML = `
    <div class="carousel-container" id="${carouselId}">
      ${imgHtml}
      ${part.img.length > 1 ? '<button class="prev-btn">&#10094;</button><button class="next-btn">&#10095;</button>' : ''}
    </div>
    <h3>${part.name}</h3>
    <p>Brand: ${part.brand}</p>
    <p>Price: $${part.price}</p>
    <button class="wishlist-btn">Add to Wishlist</button>
  `;
  container.appendChild(card);

  // Wishlist functionality
  const wishlistBtn = card.querySelector(".wishlist-btn");
  wishlistBtn.addEventListener("click", () => {
    let wishlist = JSON.parse(localStorage.getItem("wishlist")) || [];
    if (!wishlist.find(p => p.name === part.name)) {
      wishlist.push(part);
      localStorage.setItem("wishlist", JSON.stringify(wishlist));
      alert(`${part.name} added to wishlist!`);
    } else {
      alert(`${part.name} is already in wishlist!`);
    }
  });

  // Carousel functionality
  if (part.img.length > 1) {
    const carousel = document.getElementById(carouselId);
    const slides = carousel.querySelectorAll(".carousel-slide");
    let current = 0;

    const showSlide = index => {
      slides.forEach((slide, i) => slide.classList.toggle("active", i === index));
      current = index;
    };
    showSlide(0);

    // Arrow buttons
    carousel.querySelector(".prev-btn").addEventListener("click", () => {
      showSlide((current - 1 + slides.length) % slides.length);
    });
    carousel.querySelector(".next-btn").addEventListener("click", () => {
      showSlide((current + 1) % slides.length);
    });

    // Touch swipe
    let startX = 0;
    carousel.addEventListener("touchstart", e => { startX = e.touches[0].clientX; });
    carousel.addEventListener("touchend", e => {
      const diff = e.changedTouches[0].clientX - startX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) showSlide((current - 1 + slides.length) % slides.length);
        else showSlide((current + 1) % slides.length);
      }
    });

    // Autoplay
    setInterval(() => showSlide((current + 1) % slides.length), 3000);
  }
}

